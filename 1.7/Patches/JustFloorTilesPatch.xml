<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- metal, gold, silver and sterile used the same texture in vanilla, each gets its own -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TerrainDef[defName="SterileTile"]/texturePath</xpath>
    <value><texturePath>Terrain/Surfaces/SterileTile</texturePath></value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TerrainDef[defName="SilverTile"]</xpath>
    <value><texturePath>Terrain/Surfaces/SilverMetalTile</texturePath></value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TerrainDef[defName="GoldTile"]</xpath>
    <value><texturePath>Terrain/Surfaces/GoldMetalTile</texturePath></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TerrainDef[defName="SilverTile"]/color</xpath>
    <value><color>(0.83, 0.85, 0.85)</color></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TerrainDef[defName="GoldTile"]/color</xpath>
    <value><color>(0.90, 0.69, 0.10)</color></value>
  </Operation>

  <!-- puts the vanilla wood floor in the same build menu list as the light one -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/TerrainDef[defName="WoodPlankFloor"]/designatorDropdown</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/TerrainDef[defName="WoodPlankFloor"]/designatorDropdown</xpath>
      <value><designatorDropdown>Vanilla_Floor_Wood</designatorDropdown></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/TerrainDef[defName="WoodPlankFloor"]</xpath>
      <value><designatorDropdown>Vanilla_Floor_Wood</designatorDropdown></value>
    </nomatch>
  </Operation>

</Patch>
